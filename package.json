{
  "name": "jetrise",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --base=/jetrise/",
    "build:pages": "vite build --base=/jetrise/",
    "verify:pages": "node scripts/pages-release.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "vite build --base=/jetrise/",
    "test": "node --test tests/*.test.mjs",
    "test:pages": "node --test tests/*.test.mjs",
    "test:long-run": "node scripts/long-run-208.mjs && node scripts/long-run-report.mjs",
    "report:long-run": "node scripts/long-run-report.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.3.1",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
