{
  "name": "jetrise",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "build:pages": "vite build --base=/jetrise/",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:long-run": "node scripts/long-run-208.mjs && node scripts/long-run-report.mjs",
    "report:long-run": "node scripts/long-run-report.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "verify:pages": "node scripts/pages-release.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  }
}
